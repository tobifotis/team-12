<!DOCTYPE html>
<html lang="en">
<%- include('includes/head2') %>

<body class="user-workspace-page members-page">
  <svg style="display:none;">
    <filter id="displacementFilter">
      <feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence" />
      <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="7" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <%- include('includes/header') %>

  <div class="userWorkPage createGroupPage">
    <main class="userWorkGroupList">

      <div class="workspacetitleTop">
        <a href="/workspaces/<%= workspace.workspaceID %>" class="userWorkbackButDimensions" aria-label="Back">
          <img src="/images/greenArrow.svg" alt="" class="userWorkbackBut">
        </a>
        <h1 class="workspaceNameTitle"><%= workspace.workspaceName %></h1>
        <%- include('includes/workspaceMenu', { theme: 'green' }) %>
      </div>

      <div class="wmPanelWrap cgWrap">
        <section class="wmPanel">
          <h2 class="cgTitle">CREATE NEW GROUP</h2>

          <form action="/groups/create" method="POST" class="cgForm">
            <input type="hidden" name="workspaceID" value="<%= workspace.workspaceID %>" />

            <div class="cgField">
              <label for="groupName">Group Name</label>
              <input type="text" id="groupName" name="groupName" maxlength="100"
                     placeholder="Enter the group name"
                     value="<%= formData.groupName || '' %>" required />
            </div>

            <div class="cgField">
              <label for="description">Description (Optional)</label>
              <textarea id="description" name="description"
                        placeholder="Enter a short description"><%= formData.description || '' %></textarea>
            </div>

            <fieldset class="cgChoice">
              <legend>Visibility</legend>
              <div class="cgOptions">
                <label class="cgOption">
                  <input type="radio" name="visibility" value="public" <%= formData.visibility !== 'private' ? 'checked' : '' %> />
                  <span>Public</span>
                </label>
                <label class="cgOption">
                  <input type="radio" name="visibility" value="private" <%= formData.visibility === 'private' ? 'checked' : '' %> />
                  <span>Private</span>
                </label>
              </div>
            </fieldset>

            <fieldset class="cgChoice">
              <legend>Join Type</legend>
              <div class="cgOptions">
                <label class="cgOption">
                  <input type="radio" name="joinType" value="request" <%= formData.joinType !== 'open' ? 'checked' : '' %> />
                  <span>Request to join</span>
                </label>
                <label class="cgOption">
                  <input type="radio" name="joinType" value="open" <%= formData.joinType === 'open' ? 'checked' : '' %> />
                  <span>Open</span>
                </label>
              </div>
            </fieldset>

            <% if (errors.length > 0) { %>
              <ul class="cgErrors">
                <% errors.forEach(e => { %><li><%= e %></li><% }) %>
              </ul>
            <% } %>

            <button type="submit" class="cgSubmit">CREATE GROUP</button>

            <a href="/workspaces/<%= workspace.workspaceID %>" class="cgBack">
              <span class="userWorkbackButDimensions">
                <img src="/images/greenArrow.svg" alt="" class="userWorkbackBut">
              </span>
              <span>Dashboard</span>
            </a>
          </form>
        </section>
      </div>

    </main>
  </div>

  <%- include('includes/workspaceModal') %>
  <%- include('includes/footer') %>
</body>
</html>