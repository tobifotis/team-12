<!DOCTYPE html>
<html lang="en">
<%- include('includes/head2') %>

<body class="group-suggestions-page">
  <%- include('includes/header') %>

  <div class="aiSuggestPage">
    <main class="aiSuggestContent">

      <div class="workspacetitleTop">
        <a href="/workspaces/<%= workspace.workspaceID %>" class="userWorkbackButDimensions">
          <img src="/images/workspacebackBut.svg" alt="Back" class="userWorkbackBut userWorkbackButNORMAL">
          <img src="/images/workspacebackHOVER.svg" alt="Back" class="userWorkbackBut userWorkbackButHOVER">
        </a>
        <h1 class="workspaceNameTitle"><%= workspace.workspaceName %></h1>
      </div>

      <div class="suggestionsMain">
        <h1 class="suggestionsHello">Hello, <%= user.username %>.</h1>
        <p class="suggestionsSubtitle">Your Optimal Group Suggestions Await You.</p>

        <!-- skills mode toggle -->
        <div class="suggestionsModeToggle">
          <a href="?mode=complementary" class="<%= mode === 'complementary' ? 'active' : '' %>">Complementary skills</a>
          <a href="?mode=similar" class="<%= mode === 'similar' ? 'active' : '' %>">Similar skills</a>
        </div>

        <% warnings.forEach(w => { %>
          <p class="suggestionsWarning"><%= w %></p>
        <% }) %>

        <div class="suggestionsResults">
          <% if (suggestions.length === 0) { %>
            <p>No suggestions yet.</p>
          <% } else { %>
            <% suggestions.forEach(s => { %>
              <div class="suggestionCard">
                <% if (s.profilePicture) { %>
                  <img class="suggestionAvatar" src="<%= s.profilePicture %>" alt="">
                <% } %>
                <div class="suggestionInfo">
                  <h3><%= s.displayName || s.username %> <small>@<%= s.username %></small></h3>
                  <p class="suggestionMatch"><%= s.matchPercent %>% match</p>

                  <p>
                    <% if (s.noOverlap) { %>
                      No shared availability yet
                    <% } else { %>
                      <%= s.overlapHours %> hrs/week of shared availability
                    <% } %>
                  </p>

                  <% if (s.skills.length) { %>
                    <p class="suggestionSkills">
                      <% s.skills.forEach(skill => { %>
                        <span class="skillTag <%= s.sharedSkills.includes(skill) ? 'skillShared' : 'skillNew' %>"><%= skill %></span>
                      <% }) %>
                    </p>
                  <% } else { %>
                    <p>No skills listed</p>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

    </main>
  </div>

</body>
</html>
