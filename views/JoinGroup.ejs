<!DOCTYPE html>
<html lang="en">
<%- include('includes/head2') %>

<body class="user-workspace-page members-page">
  <svg style="display:none;">
    <filter id="displacementFilter">
      <feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence" />
      <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="2" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <%- include('includes/header') %>

  <div class="userWorkPage joinGroupPage">
    <main class="userWorkGroupList joinGroupContent">
      <div class="joinGroupLayout">
        <div class="joinGroupLeft">
          <div class="workspacetitleTop joinGroupTitle">
            <a href="/workspaces/<%= workspace.workspaceID %>" class="userWorkbackButDimensions" aria-label="Back">
              <img src="/images/greenArrow.svg" alt="" class="userWorkbackBut">
            </a>
            <h1 class="workspaceNameTitle"><%= workspace.workspaceName %></h1>
            <%- include('includes/workspaceMenu', { theme: 'green' }) %>
          </div>

          <% if (message) { %>
            <p class="joinGroupMessage"><%= message %></p>
          <% } %>

          <section class="joinGroupPanel joinGroupInvites">
            <h2>Group Requests</h2>
            <div class="joinGroupScroll">
              <% if (invites.length === 0 && groupInvites.length === 0) { %>
                <p class="joinGroupEmpty">No pending requests or invitations.</p>
              <% } %>
              <% groupInvites.forEach(gi => { %>
                <article class="joinGroupCard inviteCard">
                  <h3><%= gi.inviter %></h3>
                  <p>Invited you to join <strong><%= gi.groupName %></strong></p>
                  <div class="joinGroupActions">
                    <form method="post" action="/workspaces/<%= workspace.workspaceID %>/join-groups/invites/<%= gi.groupID %>/accept">
                      <button type="submit" class="joinSmallButton">Accept</button>
                    </form>
                    <form method="post" action="/workspaces/<%= workspace.workspaceID %>/join-groups/invites/<%= gi.groupID %>/decline">
                      <button type="submit" class="joinSmallButton joinDeclineButton">Deny</button>
                    </form>
                  </div>
                </article>
              <% }) %>
              <% invites.forEach(invite => { %>
                <article class="joinGroupCard inviteCard">
                  <h3><%= invite.requester %></h3>
                  <p>Wants to join <strong><%= invite.groupName %></strong></p>
                  <div class="joinGroupActions">
                    <form method="post" action="/workspaces/<%= workspace.workspaceID %>/join-groups/requests/<%= invite.id %>/approve">
                      <button type="submit" class="joinSmallButton">Accept</button>
                    </form>
                    <form method="post" action="/workspaces/<%= workspace.workspaceID %>/join-groups/requests/<%= invite.id %>/deny">
                      <button type="submit" class="joinSmallButton joinDeclineButton">Deny</button>
                    </form>
                  </div>
                </article>
              <% }) %>
            </div>
              <% if (invites.length === 0 && groupInvites.length === 0) { %>
                <img class="sleepingRosie" src="/images/sleepingRosie.webp" alt="">
              <% } %>
          </section>
        </div>

        <section class="joinGroupPanel publicGroups">
          <div class="publicGroupsHeading">
            <div>
              <h2>Public Groups</h2>
              <p>Pick a group to start collaborating.</p>
            </div>
            <span class="groupCount"><%= publicGroups.length %> available</span>
          </div>
          <div class="publicGroupsGrid">
            <% if (publicGroups.length === 0) { %>
              <p class="joinGroupEmpty publicGroupsEmpty">There are no public groups to join yet.</p>
            <% } %>
            <% publicGroups.forEach(group => { %>
              <article class="joinGroupCard publicGroupCard">
                <h3><%= group.name %></h3>
                <p>Owner: <%= group.owner %></p>
                <% if (group.requested) { %>
                  <button type="button" class="joinWideButton" disabled>Request Pending</button>
                <% } else { %>
                  <form method="post" action="/workspaces/<%= workspace.workspaceID %>/join-groups/<%= group.id %>">
                    <button type="submit" class="joinWideButton">
                      <%= group.joinType === 'open' ? 'Join' : 'Request to Join' %>
                    </button>
                  </form>
                <% } %>
              </article>
            <% }) %>
          </div>
        </section>
      </div>
    </main>
  </div>

  <%- include('includes/workspaceModal') %>
  <%- include('includes/footer') %>
<script>
  const joinMsg = document.querySelector(".joinGroupMessage");
  if (joinMsg) {
    history.replaceState(null, "", location.pathname);
    setTimeout(() => {
      joinMsg.classList.add("fade");
      setTimeout(() => joinMsg.remove(), 400);
    }, 3000);
    }
</script>
</body>
</html>