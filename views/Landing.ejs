<!DOCTYPE html>
<html lang="en">
<%- include('includes/head2') %>
<body>
  <div id="landingSkeleton" aria-hidden="true">
    <div class="skHeader">
      <div class="skBlock skLogo"></div>
      <div class="skBlock skSignin"></div>
    </div>

    <section class="skHero">
      <div class="skHeadText">
        <div class="skBlock skTitle"></div>
        <div class="skUnder">
          <div class="skBlock skUL"></div>
          <div class="skBlock skUL skUL2"></div>
        </div>
        <div class="skBlock skButton"></div>
      </div>
      <div class="skBlock skFlower"></div>
    </section>

    <section class="skPink">
      <div class="skPinkTitle">
        <div class="skBlock skPT"></div>
        <div class="skBlock skPT skPT2"></div>
      </div>

      <div class="skCards">
        <div class="skCard skCard1">
          <div class="skCardInner">
            <div class="skBlock skIllus"></div>
            <div class="skTextCol">
              <div class="skBlock skTxt"></div>
              <div class="skBlock skTxt"></div>
              <div class="skBlock skTxt"></div>
            </div>
          </div>
        </div>

        <div class="skCard skCard2">
          <div class="skCardInner">
            <div class="skTextCol">
              <div class="skBlock skTxt"></div>
              <div class="skBlock skTxt"></div>
              <div class="skBlock skTxt"></div>
            </div>
            <div class="skBlock skIllus"></div>
          </div>
        </div>

        <div class="skCard skCard3">
          <div class="skCardInner">
            <div class="skBlock skIllus"></div>
            <div class="skTextCol">
              <div class="skBlock skTxt"></div>
              <div class="skBlock skTxt"></div>
              <div class="skBlock skTxt"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="skFooter">
      <div class="skBlock skFLogo"></div>
      <div class="skBlock skCopy"></div>
    </div>
  </div>

  <svg style="display:none;">
    <filter id="displacementFilter">
      <feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="3" result="turbulence" />
      <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="13" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

<%- include('includes/header') %>

<section class="headline">
  <div class="beeWrap" aria-hidden="true">
    <div class="beeInner">
      <img src="/images/bee.webp" alt="" class="beeCursor">
    </div>
  </div>

  <div class="headline-text">
    <h1 class="headlineTitle">Groupify</h1>
    <p class="headline-under">Work effectively and smarter with people at your side.</p>
    <% if (!user) { %>
        <a href="/signup" class="getstarted">GET STARTED</a>
    <% } %>
  </div>

  <div class="flower-container">
    <img src="/images/stem.webp"             class="flowerLayer stem">
    <img src="/images/backbulb.webp"         class="flowerLayer backbulb">
    <img src="/images/lefttopouter.webp"     class="flowerLayer leftTop">
    <img src="/images/righttopouter.webp"    class="flowerLayer rightTop">
    <img src="/images/frontbulb.webp"        class="flowerLayer frontbulb">
    <img src="/images/leftlowerouter.webp"   class="flowerLayer leftLower">
    <img src="/images/rightlowerouter.webp"  class="flowerLayer rightLower">
    <img src="/images/leftmiddleouter.webp"  class="flowerLayer leftMiddle">
    <img src="/images/rightmiddleouter.webp" class="flowerLayer rightMiddle">
    <img src="/images/middlepetal.webp"      class="flowerLayer middlePetal">
  </div>
</section>

<div class="leaves-Container">
  <img src="/images/leaves.webp" alt="" class="leaves">
</div>

<section class="pinkSection">
  <h2 class="pinkSectionTitle">Connect With People Like Never Before</h2>

  <div class="pinkSectionBody">
    <div class="pinkSectionCards">

      <div class="card card1">
        <div class="cardInner">
          <img src="/images/bagAndSeed.webp" alt="bag and seed" class="illustration">
          <p class="textInCard">Plant your seed by creating a workspace</p>
        </div>
      </div>

      <div class="card card2">
        <div class="cardInner">
          <p class="textInCard">Grow your plant by inviting other users</p>
          <img src="/images/miniFlower.webp" alt="mini flower" class="illustration">
        </div>
      </div>

      <div class="card card3">
        <div class="cardInner">
          <img src="/images/wateringCan.webp" alt="watering can" class="illustration">
          <p class="textInCard">Water your plant by planning and communicating</p>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include('includes/footer') %>

<script>
  /* image following mouse (open source code from youtube) */
  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isTouch         = window.matchMedia('(pointer: coarse)').matches;

  if (!isReducedMotion && !isTouch) {
    const beeWrap  = document.querySelector('.beeWrap');
    const headline = document.querySelector('.headline');

    let targetX = -999, targetY = -999;
    let currentX = -999, currentY = -999;
    let lastX = 0;

    window.addEventListener('mousemove', (e) => {
      const rect = headline.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;

      if (e.clientX < lastX)      beeWrap.classList.add('flipped');
      else if (e.clientX > lastX) beeWrap.classList.remove('flipped');
      lastX = e.clientX;
    });

    const LERP = 0.06;

    function animate() {
      currentX += (targetX - currentX) * LERP;
      currentY += (targetY - currentY) * LERP;
      beeWrap.style.setProperty('--mouseX', `${currentX}px`);
      beeWrap.style.setProperty('--mouseY', `${currentY}px`);
      requestAnimationFrame(animate);
    }

    animate();
  }

  /* animation for pink section (bag of seed, flower, watering can) */
  const cards = document.querySelectorAll('.card');
  /* 2nd card slides from left */
  const slideFrom = { 'card1': '110vw', 'card2': '-110vw', 'card3': '110vw' };

  const cardObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const idx = [...cards].indexOf(entry.target);
        const key = ['card1','card2','card3'].find(c => entry.target.classList.contains(c));
        const dir = slideFrom[key] || '110vw';

        entry.target.style.transform = `translateX(${dir})`;
        entry.target.style.opacity = '0';

        requestAnimationFrame(() => {
          setTimeout(() => {
            entry.target.style.transition = 'opacity 1.5s ease, transform 1.8s cubic-bezier(0.22, 1, 0.36, 1)';
            entry.target.style.transform = 'translateX(0)';
            entry.target.style.opacity = '1';
          }, idx * 150);
        });

        cardObserver.unobserve(entry.target);
      }
    });
  }, 
  /* requires 20% of card to be seen */
  { threshold: 0.20 });

  cards.forEach(card => cardObserver.observe(card));

  const headlineEl = document.querySelector('.headline');
  const textEl = document.querySelector('.headline-text');
  const flowerEl = document.querySelector('.flower-container');
  const skEl = document.getElementById('landingSkeleton');

  function syncSkeleton() {
    if (!skEl) return;
    ['--flower-scale', '--text-shift'].forEach((name) => {
      const src = name === '--flower-scale' ? flowerEl : textEl;
      const v = src.style.getPropertyValue(name);
      if (v) skEl.style.setProperty(name, v);
      else skEl.style.removeProperty(name);
    });
  }

  function fitFlower() {
    if (window.innerWidth > 900) {
      flowerEl.style.removeProperty('--flower-scale');
      textEl.style.removeProperty('--text-shift');
      syncSkeleton();
      return;
    }

    const gap = 12; 
    const textBottom = textEl.offsetTop + textEl.offsetHeight;
    const space = headlineEl.clientHeight - textBottom - gap;

    const byHeight = space / 602;
    const byWidth = headlineEl.clientWidth / 684;
    const scale = Math.max(Math.min(0.88, byHeight, byWidth), 0.1);
    flowerEl.style.setProperty('--flower-scale', scale);

    const free = Math.max(0, space - 602 * scale);
    textEl.style.setProperty('--text-shift', (free * 0.5) + 'px');

    syncSkeleton();
  }

  fitFlower();
  window.addEventListener('resize', fitFlower);
  window.addEventListener('load', fitFlower);

  (function () {
    const sk = document.getElementById('landingSkeleton');
    if (!sk) return;


    const hide = () => {
      sk.classList.add('hidden');
      setTimeout(() => sk.remove(), 700);
    };

    const bgUrls = ['/images/greengradient.webp', '/images/pinkGradient.webp'];

    const imgs = [...document.querySelectorAll('img')].map(img =>
      img.complete ? Promise.resolve() : img.decode().catch(() => {})
    );
    const bgs = bgUrls.map(src => new Promise(res => {
      const i = new Image();
      i.onload = i.onerror = res;
      i.src = src;
    }));
    const timeout = new Promise(res => setTimeout(res, 5000));

    Promise.race([Promise.all([...imgs, ...bgs]), timeout]).then(hide);
  })();
</script>
</body>
</html>
