<div class="chat-individual" id="individual-conversations" role="tabpanel" aria-labelledby="individual-tab" hidden>
  <button type="button" class="chat-new-message" id="pc-new">+ New Message</button>

  <div class="chat-user-picker" id="pc-picker" hidden>
    <label class="visually-hidden" for="pc-search">Search users</label>
    <input type="search" id="pc-search" placeholder="Search by username or name" maxlength="100" autocomplete="off">
    <div class="chat-user-results" id="pc-results" role="listbox" aria-label="Users"></div>
  </div>

  <div class="chat-conversation-list" id="pc-list" aria-label="Private conversations"></div>
</div>
