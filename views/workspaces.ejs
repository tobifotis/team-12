<!DOCTYPE html>
<html lang="en">
<%- include('includes/head2') %>

<body class="homepagebody">
  <svg style="display:none;">
    <filter id="displacementFilter">
      <feTurbulence type="turbulence"
        baseFrequency="0.01"
        numOctaves="3"
        result="turbulence" />
      <feDisplacementMap in="SourceGraphic"
        in2="turbulence"
        scale="13"
        xChannelSelector="R"
        yChannelSelector="G" />
    </filter>
  </svg>
  <%- include('includes/header') %>
  <div class="homepage">
  <div class="workspaceHeadCover"></div>
  <svg class="homepageBackground" preserveAspectRatio="xMidYMid slice" viewBox="0 0 1440 829" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect width="1440" height="829" fill="url(#homepage-bg-gradient)"/>
    <defs>
      <radialGradient id="homepage-bg-gradient" cx="0" cy="0" r="1" gradientTransform="matrix(331 651.913 -1132.39 544.334 389 177.087)" gradientUnits="userSpaceOnUse">
        <stop stop-color="#161973"/>
        <stop offset="0.537498" stop-color="#635C98"/>
        <stop offset="1" stop-color="#5F7985"/>
      </radialGradient>
    </defs>
  </svg>

  <% if (!workspaces || workspaces.length === 0) { %>

    <div class="noworkspace-layout">
      <div class="noworkspacecontainer">
        <img class="starsNoWorkspace" src="/images/starsNoWorkspace.webp" alt="">
        <h2>You Are Currently Not in Any Workspaces</h2>
        <div class="rightSideButtons">
          <span class="seedWrap">
            <a href="/workspaces/create" class="createbutton"><span>Create Workspace</span></a>
            <img class="seed s1" src="/images/seed1.png" alt="">
            <img class="seed s2" src="/images/seed2.png" alt="">
            <img class="seed s3" src="/images/seed3.png" alt="">
            <img class="seed s4" src="/images/seed1.png" alt="">
            <img class="seed s5" src="/images/seed2.png" alt="">
          </span>
          <span class="orText">Or</span>
          <span class="seedWrap">
          <a href="/workspaces/join-page" class="joinButton"><span>Join Workspace</span></a>
          <img class="seed s1" src="/images/seed1.png" alt="">
          <img class="seed s2" src="/images/seed2.png" alt="">
          <img class="seed s3" src="/images/seed3.png" alt="">
          <img class="seed s4" src="/images/seed1.png" alt="">
          <img class="seed s5" src="/images/seed2.png" alt="">
          </span>
        </div>
      </div>
      <img class="groundNoWorkspace" src="/images/groundNoWorkspace.png" alt="">
    </div>

  <% } else { %>

      <picture>
        <source media="(max-width: 900px)" srcset="/images/groundMobile.png">
        <img class="ground" src="/images/ground.png" alt="">
      </picture>

      <main class="homepage-layout">
      <section class="homepage-left">
        <h2>Your Workspaces</h2>
        <div class="workspace-list">
          <% workspaces.forEach(workspace => { %>
            <a href="/workspaces/<%= workspace.workspaceID %>" class="workspace-link">
              <div class="workspaceCard">
                <div class="workspacetitle"><%= workspace.workspaceName %></div>
              </div>
            </a>
          <% }) %>
        </div>
      </section>

      <section class="homepage-right">
        <div class="right-content-wrapper">
          <img class="topStars" src="/images/topStars.webp" alt="">
          <img class="bottomStars" src="/images/bottomStars.webp" alt="">
          <h2>Enter a New Workspace</h2>
          <div class="rightSideButtons">
          <span class="seedWrap">
            <a href="/workspaces/create" class="createbutton"><span>Create Workspace</span></a>
            <img class="seed s1" src="/images/seed1.png" alt="">
            <img class="seed s2" src="/images/seed2.png" alt="">
            <img class="seed s3" src="/images/seed3.png" alt="">
            <img class="seed s4" src="/images/seed1.png" alt="">
            <img class="seed s5" src="/images/seed2.png" alt="">
          </span>
          <span class="orText">Or</span>
          <span class="seedWrap">
          <a href="/workspaces/join-page" class="joinButton"><span>Join Workspace</span></a>
          <img class="seed s1" src="/images/seed1.png" alt="">
          <img class="seed s2" src="/images/seed2.png" alt="">
          <img class="seed s3" src="/images/seed3.png" alt="">
          <img class="seed s4" src="/images/seed1.png" alt="">
          <img class="seed s5" src="/images/seed2.png" alt="">
          </span>
          </div>
        </div>
      </section>
    </main>

  <% } %>
  </div>

  <%- include('includes/footer') %>

<script>
  document.querySelectorAll('.seedWrap').forEach(wrap => {
    const seeds = wrap.querySelectorAll('.seed');

    const stop = e => {
      e.target.classList.remove('falling');
      delete e.target.dataset.live;
    };

    seeds.forEach(s => {
      s.addEventListener('animationstart', () => { s.dataset.live = '1'; });
    });

    wrap.addEventListener('mouseenter', () => {
      seeds.forEach(s => {
        s.removeEventListener('animationiteration', stop);
        s.classList.add('falling');
      });
    });

    wrap.addEventListener('mouseleave', () => {
      seeds.forEach(s => {
        if (s.dataset.live) {
          s.addEventListener('animationiteration', stop, { once: true });
        } else {
          s.classList.remove('falling');
        }
      });
    });
  });

  const homeEl = document.querySelector('.homepage');
  const groundEl = document.querySelector('.ground, .groundNoWorkspace');

  if (homeEl && groundEl) {
    const setGroundHeight = () => {
      homeEl.style.setProperty('--ground-h', groundEl.offsetHeight + 'px');
    };
    setGroundHeight();
    groundEl.addEventListener('load', setGroundHeight);
    new ResizeObserver(setGroundHeight).observe(groundEl);
  }
</script>
</body>
</html>
